{
  "name": "flick-owens-dotdev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "assets:ds:check": "node scripts/import-ds-assets.mjs",
    "assets:ds:import": "node scripts/import-ds-assets.mjs --import",
    "assets:ds:crops": "node scripts/build-ds-crops.mjs",
    "assets:ds:motion": "node scripts/build-ds-motion-assets.mjs",
    "assets:ds:model:check": "node scripts/check-ds-lite-model.mjs",
    "assets:ds:accessories:check": "node scripts/check-ds-accessories.mjs",
    "assets:ds:accessories:build": "node scripts/build-ds-accessories.mjs && node scripts/check-ds-accessories.mjs",
    "assets:ds:roms:check": "node scripts/check-ds-rom-assets.mjs",
    "runtime:skyemu:build": "node scripts/build-skyemu-adapter.mjs",
    "assets:ds:model:normalize": "node scripts/normalize-ds-lite-model.mjs",
    "assets:ds:overlay": "node scripts/build-ds-overlay.mjs",
    "assets:ds:overlay:import": "node scripts/build-ds-overlay.mjs --import"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "howler": "^2.2.4",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@gltf-transform/core": "^4.4.2",
    "@mdx-js/rollup": "^3.1.1",
    "@openai/sites-vite-plugin": "^0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/howler": "^2.2.12",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "^19.2.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "^4.92.0"
  },
  "type": "module"
}
